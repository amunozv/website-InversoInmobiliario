# Inverso Inmobiliario - URLs limpias y seguridad básica
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forzar HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # 3. /index -> /
  RewriteRule ^index$ / [R=301,L]

  # 4. /pagina.html -> /pagina (301)
  #    Se excluyen los parciales que se cargan por fetch.
  RewriteCond %{REQUEST_URI} !/partials/
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+?)\.html$ /$1 [R=301,L,NE]

  # 5. Quitar barra final en URLs que no son directorios reales
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 6. Servir internamente /pagina como /pagina.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# 7. Bloquear acceso a la carpeta .git
RedirectMatch 404 /\.git
